# Deny-by-default repository root.
# Inherited material stays ignored until audited. Explicit allowlist below.
*
!/.gitignore
!/.github/
!/.github/workflows/
!/.github/workflows/verify.yml
!/.github/scripts/
!/.github/scripts/**
!/GOVERNANCE.md
!/EVIDENCE-INDEX.md
!/GOVERNANCE-BACKLOG.md
!/SOURCE-CLASSIFICATION.md

# SDD baseline allowlist, sin stage/push automático
!sdd/
!sdd/**
!/docs/
!/docs/agent/
!/docs/agent/**
!/backend/
!/backend/**
!/frontend/
!/frontend/**
!AGENTS.md
!/.cursor/
!/.cursor/rules/
!/.cursor/rules/**
!README.md
!CHANGELOG.md
!GOVERNANCE.md
!SOURCE-CLASSIFICATION.md
!EVIDENCE-INDEX.md

# Build and dependency outputs stay out of the allowlist
backend/target/
backend/media-worker/target/
frontend/node_modules/
frontend/.npm-cache/
frontend/dist/
frontend/.angular/
frontend/playwright-report/
frontend/test-results/
frontend/ua-real-results/
frontend/psd-real-results/
frontend/recovery-real-results/
!/docs/testing/
!/docs/testing/**
frontend/demo-playwright-report/
frontend/debug.log

# Security exclusions win over the source allowlist above.
# Only inert environment templates may be versioned.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# Private keys and credential containers.
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.ppk
**/*.kdbx

# Database dumps, backups and local databases. Source migrations and the
# explicit E2E fixture area are enforced separately by the repository gate.
**/*.dump
**/*.bak
**/*.backup
**/*.sqlite
**/*.sqlite3
**/*.db
**/dump.sql
**/*-dump.sql
**/*_dump.sql
**/backup.sql
**/*-backup.sql
**/*_backup.sql
