[Unit]
Description=StoreCore isolated media worker
Documentation=file:sdd/wip/20261116-catalog-media-upload-and-variant-gallery/2-technical/adr/ADR-001-isolated-image-normalizer.md

[Service]
Type=exec
User=storecore-media-worker
Group=storecore-media-worker
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
DevicePolicy=closed
MemoryMax=289406976
MemorySwapMax=0
MemoryOOMGroup=yes
TasksMax=32
CPUQuota=100%
LimitCORE=0
LimitNOFILE=64
LimitNPROC=32
KillMode=control-group
RuntimeMaxSec=12s
TimeoutStopSec=2s
SendSIGKILL=yes
KillSignal=SIGKILL
CapabilityBoundingSet=
AmbientCapabilities=
WorkingDirectory=%d
ReadWritePaths=%d
NoExecPaths=%d
InaccessiblePaths=/home
ExecStart=/usr/lib/jvm/temurin-21/bin/java -Xmx201326592 -XX:MaxDirectMemorySize=20971520 -Djava.io.tmpdir=%d -jar /usr/lib/storecore/storecore-media-worker.jar
