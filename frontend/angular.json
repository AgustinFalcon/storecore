{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "storecore-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "sc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["src/styles.scss"],
            "inlineStyleLanguage": "scss"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                { "type": "initial", "maximumWarning": "700kB", "maximumError": "900kB" },
                { "type": "anyComponentStyle", "maximumWarning": "12kB", "maximumError": "20kB" }
              ]
            },
            "development": { "optimization": false, "sourceMap": true },
              "demo": {
                "browser": "src/main.demo.ts",
                "index": { "input": "src/index.demo.html", "output": "index.html" },
                "tsConfig": "tsconfig.demo.json",
                "assets": [{ "glob": "**/*", "input": "src/assets/demo", "output": "assets/demo" }],
                "optimization": true,
                "sourceMap": false,
                "preserveSymlinks": true,
                "outputHashing": "all",
                "outputPath": "dist/storecore-demo",
                "budgets": [
                  { "type": "initial", "maximumWarning": "1.9MB", "maximumError": "2MB" },
                  { "type": "anyComponentStyle", "maximumWarning": "36kB", "maximumError": "40kB" }
                ]
              },
              "demo-test": {
                "browser": "src/main.demo.ts",
                "index": { "input": "src/index.demo.html", "output": "index.html" },
                "tsConfig": "tsconfig.demo.json",
                "assets": [{ "glob": "**/*", "input": "src/assets/demo", "output": "assets/demo" }],
                "optimization": false,
                "sourceMap": true,
                "preserveSymlinks": true,
                "outputPath": "dist/storecore-demo"
              }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": { "buildTarget": "storecore-frontend:build:production" },
            "development": { "buildTarget": "storecore-frontend:build:development" },
            "demo": { "buildTarget": "storecore-frontend:build:demo", "proxyConfig": "proxy.demo.json" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest"
          }
        }
      }
    }
  }
}
