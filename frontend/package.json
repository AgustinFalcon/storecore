{
  "name": "storecore-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "ng serve",
    "start:demo": "ng serve --configuration demo --host 127.0.0.1 --port 4200",
    "build:demo": "ng build --configuration demo",
    "test:demo": "npm run build:demo && node demo-e2e/run.mjs",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:a11y": "playwright test",
    "test:ua-real-local": "playwright test --config playwright.ua-real-local.config.ts",
    "lint": "eslint src e2e ua-real-local playwright.ua-real-local.config.ts",
    "check:architecture": "node --test scripts/domain-boundary.test.mjs && node scripts/check-architecture.mjs",
    "verify": "npm run check:architecture && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@angular/common": "~22.2.1",
    "@angular/compiler": "~22.2.1",
    "@angular/core": "~22.2.1",
    "@angular/forms": "~22.2.1",
    "@angular/platform-browser": "~22.2.1",
    "@angular/router": "~22.2.1",
    "@ngrx/component-store": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.1",
    "@angular/cli": "~22.2.1",
    "@angular/compiler-cli": "~22.2.1",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.0.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.8"
  }
}
